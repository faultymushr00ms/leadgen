# Environment — never commit your API keys
.env

# Raw data files — add your CSV exports here, they stay local
data/*.csv
data/*.xlsx

# Generated files — rebuilt on each run
output/
models/

# PUCO Government Aggregation geometry. No explicit license.
# Fetched snapshots are append-only and stay in this cache.
data/cache/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
