<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.forge.nightlyscan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_FULL_PATH/scripts/nightly_scan.sh</string>
    </array>

    <!-- Run daily at 6:30 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Catch up if Mac was asleep when the job was due -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_FULL_PATH/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_FULL_PATH/logs/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_FULL_PATH</string>
</dict>
</plist>
